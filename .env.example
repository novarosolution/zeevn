# Zeevan — Expo app environment (copy to `.env` in repo root)
# Only EXPO_PUBLIC_* values are embedded in client builds. Never put secrets here.
# Restart Expo after changes: npm run start

# ─── API ─────────────────────────────────────────────────────────────────────

# Backend origin (no trailing slash unless API uses a path prefix)
# Required for production native builds; recommended for all dev setups
EXPO_PUBLIC_API_URL=http://127.0.0.1:5001

# ─── Auth (feature flags) ────────────────────────────────────────────────────

# Enable captcha on web register / forgot-password
# EXPO_PUBLIC_AUTH_CAPTCHA_ENABLED=false

# Site key from reCAPTCHA or hCaptcha dashboard (public)
# EXPO_PUBLIC_AUTH_CAPTCHA_SITE_KEY=

# recaptcha | hcaptcha
# EXPO_PUBLIC_AUTH_CAPTCHA_PROVIDER=recaptcha

# ─── Payments ──────────────────────────────────────────────────────────────────

# Razorpay Key ID (public — must match backend RAZORPAY_KEY_ID)
# EXPO_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx

# Fallback payment link when gateway UI is unavailable
# EXPO_PUBLIC_RAZORPAY_PAYMENT_LINK=https://razorpay.me/@your-handle

# ─── Observability (Sentry) ───────────────────────────────────────────────────

# Client DSN — tags: appVersion, platform, route, hashed userId
# EXPO_PUBLIC_SENTRY_DSN=
# EXPO_PUBLIC_SENTRY_ENVIRONMENT=development
# EXPO_PUBLIC_APP_VERSION=1.0.0

# ─── Brand (white-label / copy) ──────────────────────────────────────────────

# EXPO_PUBLIC_BRAND_NAME=Zeevan
# EXPO_PUBLIC_BRAND_TAGLINE=Heritage pantry essentials, delivered beautifully
# EXPO_PUBLIC_BRAND_SUBLINE=Heritage pantry
# EXPO_PUBLIC_SEARCH_PLACEHOLDER=Search ghee, staples, and pantry picks...
# EXPO_PUBLIC_SUPPORT_EMAIL=support@zeevan.app
# EXPO_PUBLIC_SUPPORT_WHATSAPP_URL=https://wa.me/919999999999
# EXPO_PUBLIC_ENGINEER_NAME=NovaRo Solution
# EXPO_PUBLIC_ENGINEER_URL=https://example.com/

# ─── Expo / EAS build identity (optional, build-time only) ───────────────────

# APP_NAME=Zeevan
# APP_SLUG=zeevan
# APP_SCHEME=zeevan
# APP_OWNER=
# IOS_BUNDLE_IDENTIFIER=com.zeevan.app
# ANDROID_PACKAGE=com.zeevan.app
# EAS_PROJECT_ID=

# ─── Tooling ─────────────────────────────────────────────────────────────────

# Fail CI on token violations (default: warn only)
# TOKEN_CHECK_STRICT=0
