# Zeevan API — copy to `backend/.env` (or use root `.env`; server loads both)
# Never commit real secrets. Use strong random values in production.

# ─── Server ──────────────────────────────────────────────────────────────────

# HTTP port
PORT=5001

# development | production | test
NODE_ENV=development

# E2E only: expose /test/issue-verification-token (never enable in production)
# ENABLE_TEST_ROUTES=true

# Comma-separated extra CORS origins (Expo web ports are allowed by default)
# CORS_ORIGINS=http://localhost:19006,http://127.0.0.1:8081

# ─── Database ────────────────────────────────────────────────────────────────

# Required — one of these names is accepted (first non-empty wins)
MONGO_URI=mongodb://127.0.0.1:27017/zeevan

# Optional database name override
# MONGODB_URI=
# DATABASE_URL=
# DB_URI=
# MONGO_DB_NAME=zeevan
# DB_NAME=

# ─── Auth (JWT) ──────────────────────────────────────────────────────────────

# Required — signing secret for access tokens
JWT_SECRET=change-me-to-a-long-random-string

# Optional separate refresh secret (falls back to JWT_SECRET)
# JWT_REFRESH_SECRET=

# Token lifetimes (e.g. 15m, 7d)
# JWT_EXPIRES_IN=15m
# JWT_REFRESH_EXPIRES_IN=7d

# ─── Email (SMTP) ────────────────────────────────────────────────────────────

# All four required to send mail; omit for dev (verify/reset return devLink in non-prod)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=notifications@example.com
# SMTP_PASS=your-smtp-password
# SMTP_FROM=Zeevan <notifications@example.com>

# Public web app URL for links in emails (no trailing slash)
APP_WEB_URL=http://localhost:8081

# Alias for APP_WEB_URL
# WEB_APP_URL=http://localhost:8081

# Brand name in email templates
# MAIL_BRAND_NAME=Zeevan

# ─── Payments (Razorpay) ─────────────────────────────────────────────────────

# Required for online checkout
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
# RAZORPAY_KEY_SECRET=your_razorpay_secret
# RAZORPAY_WEBHOOK_SECRET=whsec_xxxxxxxx

# Webhook URL: https://<host>/orders/razorpay-webhook (or /api/orders/...)

# ─── Cloudinary (media uploads) ──────────────────────────────────────────────

# Option A: single URL (includes cloud name + credentials)
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Option B: discrete vars
# CLOUDINARY_CLOUD_NAME=your_cloud
# CLOUDINARY_API_KEY=123456789012345
# CLOUDINARY_API_SECRET=your_api_secret

# Optional upload folders
# CLOUDINARY_UPLOAD_PREFIX=zeevan
# CLOUDINARY_PRODUCT_FOLDER=zeevan/products
# CLOUDINARY_AVATAR_FOLDER=zeevan/avatars

# ─── Observability ───────────────────────────────────────────────────────────

# Sentry DSN (backend errors + slow requests)
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=zeevan-api@1.0.0
# LOG_LEVEL=info

# ─── Maps (delivery routing) ─────────────────────────────────────────────────

# Server-side Directions API (first non-empty wins)
# GOOGLE_MAPS_ROUTES_API_KEY=
# GOOGLE_MAPS_API_KEY=
# GOOGLE_MAPS_SERVER_KEY=
