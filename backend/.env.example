# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/zeevan

# Auth (required for login/register)
JWT_SECRET=change-me-in-production
# Comma-separated emails granted isAdmin when they sign in with a VERIFIED Google/Apple email.
# No default: other staff are promoted from the admin Users screen.
# ADMIN_EMAILS=owner@example.com

# Optional auth tuning
# JWT_REFRESH_SECRET=
# JWT_EXPIRES_IN=7d
# JWT_REFRESH_EXPIRES_IN=30d

# Cloudinary — required for avatar/product image uploads (API starts without these)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# Or: CLOUDINARY_URL=cloudinary://key:secret@cloud_name

# YouPI-PG (self-hosted). Deploy writes these on EC2. Admin login is ADMIN_API_TOKEN.
# YOUPI_API_URL=http://127.0.0.1:6100
# YOUPI_MERCHANT_ID=00000000-0000-0000-0000-000000000001
# YOUPI_WEBHOOK_SECRET=
# YOUPI_RETURN_URL=https://www.zeevan.shop/orders
# Real UPI collect (used even if YouPI is down)
# UPI_COLLECT_VPA=8320631598@ybl
# UPI_COLLECT_PAYEE=Zeevan

# Razorpay — used only when YouPI is not configured
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# Email (optional)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=

# OAuth: social sign-in answers 503 until the matching client ids are set (comma-separated for several).
# GOOGLE_OAUTH_CLIENT_ID=
# APPLE_CLIENT_ID=
# APPLE_BUNDLE_ID=

# Maps / delivery (optional)
# GOOGLE_MAPS_API_KEY=

# WhatsApp admin alerts (optional)
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# ADMIN_WHATSAPP_PHONE=

# Server
PORT=5001
# Browser origins beyond the built-in shop domains (Vercel previews, EC2 address, ...)
# CORS_EXTRA_ORIGINS=https://my-preview.vercel.app,http://54.173.67.136
