# Zeevan API — copy to backend/.env (or root .env; server loads both)
# Never commit real secrets.

# ---- Required ----
MONGO_URI=mongodb://127.0.0.1:27017/zeevan_dev
JWT_SECRET=<32+ char random string>
PORT=5001

# ---- Core runtime ----
NODE_ENV=development
# APP_WEB_URL=http://localhost:8081
# WEB_APP_URL=http://localhost:8081
# CORS_ORIGINS=http://localhost:19006,http://127.0.0.1:8081

# Optional alternate Mongo env names (first non-empty wins)
# MONGODB_URI=
# DATABASE_URL=
# DB_URI=
# MONGO_DB_NAME=zeevan
# DB_NAME=

# Optional auth tuning
# JWT_REFRESH_SECRET=
# JWT_EXPIRES_IN=15m
# JWT_REFRESH_EXPIRES_IN=7d

# ---- Optional (feature-gated) ----
# Image uploads (admin product photos, user avatars)
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
# OR
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# CLOUDINARY_UPLOAD_PREFIX=zeevan
# CLOUDINARY_PRODUCT_FOLDER=zeevan/products
# CLOUDINARY_AVATAR_FOLDER=zeevan/avatars

# Payments (checkout flow)
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# Transactional email (auth, orders)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Zeevan <notifications@example.com>
# SMTP_SECURE=true
# MAIL_BRAND_NAME=Zeevan

# Observability
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=zeevan-api@1.0.0
# LOG_LEVEL=info

# Maps (delivery routing)
# GOOGLE_MAPS_ROUTES_API_KEY=
# GOOGLE_MAPS_API_KEY=
# GOOGLE_MAPS_SERVER_KEY=
