# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/zeevan

# Auth (required for login/register)
JWT_SECRET=change-me-in-production

# Optional auth tuning
# JWT_REFRESH_SECRET=
# JWT_EXPIRES_IN=7d
# JWT_REFRESH_EXPIRES_IN=30d

# Cloudinary — required for avatar/product image uploads (API starts without these)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# Or: CLOUDINARY_URL=cloudinary://key:secret@cloud_name

# Razorpay — required for checkout
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# Email (optional)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=

# OAuth (optional)
# GOOGLE_OAUTH_CLIENT_ID=
# APPLE_CLIENT_ID=
# APPLE_BUNDLE_ID=

# Maps / delivery (optional)
# GOOGLE_MAPS_API_KEY=

# WhatsApp admin alerts (optional)
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# ADMIN_WHATSAPP_PHONE=

# Server
PORT=5001
# CORS_EXTRA_ORIGINS=https://zeevan.shop,https://www.zeevan.shop
