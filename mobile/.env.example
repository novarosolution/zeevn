# API — defaults to http://127.0.0.1:5001 in Expo dev when unset
EXPO_PUBLIC_API_URL= https://zeevn-i760.onrender.com

# Production (see .env.production.example):
# EXPO_PUBLIC_API_URL=https://zeevn-i760.onrender.com
# EXPO_PUBLIC_SITE_URL=https://zeevan.shop
# EXPO_PUBLIC_API_URL_FALLBACK=

# Site / SEO
# EXPO_PUBLIC_SITE_URL=https://www.zeevan.app

# Razorpay — required for checkout
# EXPO_PUBLIC_RAZORPAY_KEY_ID=

# OAuth (optional — social sign-in stays disabled until set)
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
# EXPO_PUBLIC_APPLE_CLIENT_ID=
