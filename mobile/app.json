{
  "expo": {
    "name": "Zeevan",
    "slug": "kankreg",
    "scheme": "zeevan",
    "version": "1.0.0",
    "orientation": "portrait",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "userInterfaceStyle": "automatic",
    "icon": "./assets/app-icon-dark.png",
    "web": {
      "favicon": "./assets/app-icon-dark.png",
      "bundler": "metro"
    },
    "ios": {
      "infoPlist": {
        "CADisableMinimumFrameDurationOnPhone": true,
        "NSLocationWhenInUseUsageDescription": "Allow Zeevan to access your location to auto-fill delivery address.",
        "NSUserNotificationUsageDescription": "Allow Zeevan to send order updates and important announcements."
      }
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/app-icon-z-mark.png",
        "backgroundColor": "#0F3D24"
      },
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "INTERNET",
        "POST_NOTIFICATIONS",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Zeevan to use your location to auto-fill delivery address."
        }
      ],
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-mark.png",
          "resizeMode": "contain",
          "backgroundColor": "#FBF6EC",
          "dark": {
            "image": "./assets/splash-mark-dark.png",
            "backgroundColor": "#0F3D24"
          },
          "ios": { "imageWidth": 240 },
          "android": { "imageWidth": 288 }
        }
      ],
      "expo-asset",
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-video"
    ]
  }
}
