{
  "buildCommand": "EXPO_PUBLIC_API_URL=https://www.zeevan.shop/aws EXPO_PUBLIC_SITE_URL=https://zeevan.shop EXPO_PUBLIC_API_URL_FALLBACK=https://zeevn-i760.onrender.com npm run export:web",
  "outputDirectory": "dist",
  "installCommand": "npm ci --include=dev",
  "rewrites": [
    {
      "source": "/aws/socket.io",
      "destination": "http://54.173.67.136:5001/socket.io/"
    },
    {
      "source": "/aws/socket.io/",
      "destination": "http://54.173.67.136:5001/socket.io/"
    },
    {
      "source": "/aws/socket.io/:path*",
      "destination": "http://54.173.67.136:5001/socket.io/:path*"
    },
    {
      "source": "/aws",
      "destination": "http://54.173.67.136:5001/"
    },
    {
      "source": "/aws/",
      "destination": "http://54.173.67.136:5001/"
    },
    {
      "source": "/aws/:path*",
      "destination": "http://54.173.67.136:5001/:path*"
    },
    {
      "source": "/youpi-admin",
      "destination": "http://54.173.67.136/youpi-admin/"
    },
    {
      "source": "/youpi-admin/:path*",
      "destination": "http://54.173.67.136/youpi-admin/:path*"
    },
    {
      "source": "/pay",
      "destination": "http://54.173.67.136/pay/"
    },
    {
      "source": "/pay/:path*",
      "destination": "http://54.173.67.136/pay/:path*"
    },
    {
      "source": "/api/v1/admin/:path*",
      "destination": "http://54.173.67.136/api/v1/admin/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/aws/socket.io",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/aws/socket.io/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/aws/media/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }
      ]
    },
    {
      "source": "/_expo/static/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)\\.(webp|png|jpg|jpeg|gif|ico|svg|woff2?)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)\\.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "Content-Type", "value": "application/javascript; charset=utf-8" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
