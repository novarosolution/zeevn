{
  "name": "zeevan-ecommerce-app",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-chart-kit"
        ]
      }
    }
  },
  "scripts": {
    "start": "expo start",
    "start:clean": "expo start --clear",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "doctor": "npx expo-doctor",
    "config:app": "npx expo config --type public",
    "export:web": "expo export --platform web && node scripts/post-export-web.js",
    "optimize:assets": "node scripts/optimize-hero-images.js && node scripts/copy-fonts-public.js",
    "lhci": "lhci autorun",
    "lhci:collect": "lhci collect",
    "deploy:check": "npm run lint && npm run doctor && npm run config:app && npm run export:web",
    "build:android": "npx eas-cli@latest build --platform android --profile production",
    "build:ios": "npx eas-cli@latest build --platform ios --profile production",
    "icons:generate": "node scripts/generate-app-icons.js",
    "lint": "expo lint",
    "test": "npm run test:unit && npm run check:tokens",
    "test:unit": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:a11y": "playwright test tests/e2e/a11y.spec.ts --project=chromium",
    "test:a11y:report": "node scripts/axe-report.js",
    "sentry:upload-sourcemaps": "node scripts/sentry-upload-sourcemaps.js",
    "check:tokens": "node scripts/check-tokens.js",
    "prepare": "husky"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/playfair-display": "^0.4.2",
    "@expo/metro-runtime": "~5.0.5",
    "@expo/vector-icons": "^14.1.0",
    "@mapbox/polyline": "^1.2.1",
    "@react-native-async-storage/async-storage": "2.1.2",
    "@react-native-community/netinfo": "11.4.1",
    "@react-navigation/native": "^7.1.14",
    "@react-navigation/native-stack": "^7.3.21",
    "@sentry/react": "^10.53.1",
    "@sentry/react-native": "^8.11.1",
    "expo": "~53.0.0",
    "expo-asset": "~11.1.7",
    "expo-blur": "~14.1.5",
    "expo-build-properties": "~0.14.8",
    "expo-clipboard": "~7.1.5",
    "expo-constants": "~17.1.8",
    "expo-device": "~7.1.4",
    "expo-file-system": "~18.1.11",
    "expo-font": "~13.3.2",
    "expo-haptics": "~14.1.4",
    "expo-image": "~2.4.1",
    "expo-image-picker": "~16.1.4",
    "expo-linear-gradient": "~14.1.5",
    "expo-linking": "~7.1.7",
    "expo-local-authentication": "~16.0.5",
    "expo-location": "~18.1.6",
    "expo-notifications": "~0.31.5",
    "expo-print": "~14.1.4",
    "expo-secure-store": "~14.2.4",
    "expo-sharing": "~13.1.5",
    "expo-splash-screen": "~0.30.10",
    "expo-status-bar": "~2.2.3",
    "expo-video": "~2.2.2",
    "gsap": "^3.15.0",
    "jest": "~29.7.0",
    "jest-expo": "~53.0.14",
    "leaflet": "^1.9.4",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-leaflet": "^5.0.0",
    "react-native": "0.79.6",
    "react-native-chart-kit": "^6.12.0",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-maps": "1.20.1",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-svg": "15.11.2",
    "react-native-web": "^0.20.0",
    "web-vitals": "^4.2.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@lhci/cli": "^0.14.0",
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/react": "~19.0.10",
    "babel-plugin-module-resolver": "^5.0.3",
    "eslint": "^8.57.1",
    "eslint-config-expo": "~9.2.0",
    "eslint-plugin-react-native-a11y": "^3.5.1",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-expo": "~53.0.4",
    "react-native-svg-transformer": "^1.5.3",
    "serve": "^14.2.6",
    "sharp": "^0.33.5",
    "typescript": "~5.8.3",
    "wait-on": "^8.0.5"
  }
}
